<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" pageWidth="142" pageHeight="57" columnWidth="142" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="4.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="no_rawat" class="java.lang.String"/>
	<queryString>
		<![CDATA[select reg_periksa.no_rawat,reg_periksa.no_rkm_medis,pasien.nm_pasien,pasien.tgl_lahir,
case
    when pasien.tgl_lahir is null then ''
    when timestampdiff(year,pasien.tgl_lahir,reg_periksa.tgl_registrasi)>0 and timestampdiff(month,date_add(pasien.tgl_lahir,interval timestampdiff(year,pasien.tgl_lahir,reg_periksa.tgl_registrasi) year),reg_periksa.tgl_registrasi)>0 then concat(timestampdiff(year,pasien.tgl_lahir,reg_periksa.tgl_registrasi),' Th ',timestampdiff(month,date_add(pasien.tgl_lahir,interval timestampdiff(year,pasien.tgl_lahir,reg_periksa.tgl_registrasi) year),reg_periksa.tgl_registrasi),' Bl')
    when timestampdiff(year,pasien.tgl_lahir,reg_periksa.tgl_registrasi)>0 then concat(timestampdiff(year,pasien.tgl_lahir,reg_periksa.tgl_registrasi),' Th')
    when timestampdiff(month,pasien.tgl_lahir,reg_periksa.tgl_registrasi)>0 then concat(timestampdiff(month,pasien.tgl_lahir,reg_periksa.tgl_registrasi),' Bl')
    else '0 Bl'
end as umur
from reg_periksa inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis where reg_periksa.no_rawat=$P{no_rawat}]]>
	</queryString>
	<field name="no_rawat" class="java.lang.String"/>
	<field name="no_rkm_medis" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="tgl_lahir" class="java.sql.Date"/>
	<field name="umur" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="57" splitType="Stretch">
			<rectangle>
				<reportElement x="1" y="1" width="140" height="55" forecolor="#006666"/>
				<graphicElement>
					<pen lineWidth="0.75"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement x="6" y="6" width="26" height="12"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[No.RM]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement x="33" y="5" width="103" height="14"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[": "+$F{no_rkm_medis}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="6" y="21" width="26" height="12"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[Nama]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement x="33" y="21" width="103" height="12"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" size="7" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[": "+$F{nm_pasien}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="6" y="36" width="26" height="12"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[TTL]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement x="33" y="36" width="103" height="12"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Tahoma" size="7" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[": "+($F{tgl_lahir}==null?"":new java.text.SimpleDateFormat("dd MMMM yyyy").format($F{tgl_lahir}))+" ("+$F{umur}+")"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
