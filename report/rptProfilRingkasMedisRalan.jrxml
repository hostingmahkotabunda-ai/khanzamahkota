            <line><reportElement x="425" y="0" width="0" height="70"/></line>
            <image scaleImage="RetainShape"><reportElement x="10" y="6" width="82" height="56"/><imageExpression><![CDATA[$P{logo}]]></imageExpression></image>
            <textField isBlankWhenNull="true"><reportElement x="96" y="11" width="320" height="48"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="17" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{namars}]]></textFieldExpression></textField>
            <staticText><reportElement x="435" y="6" width="62" height="15"/><textElement><font size="10" isBold="true"/></textElement><text><![CDATA[Nama]]></text></staticText>
            <staticText><reportElement x="435" y="24" width="62" height="15"/><textElement><font size="10" isBold="true"/></textElement><text><![CDATA[No. RM]]></text></staticText>
            <staticText><reportElement x="435" y="42" width="62" height="15"/><textElement><font size="10" isBold="true"/></textElement><text><![CDATA[Tgl. Lahir]]></text></staticText>
            <staticText><reportElement x="497" y="6" width="10" height="15"/><text><![CDATA[:]]></text></staticText>
            <staticText><reportElement x="497" y="24" width="10" height="15"/><text><![CDATA[:]]></text></staticText>
            <staticText><reportElement x="497" y="42" width="10" height="15"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="507" y="6" width="285" height="15"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$P{nama}]]></textFieldExpression></textField>
            <textField><reportElement x="507" y="24" width="285" height="15"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$P{norm}]]></textFieldExpression></textField>
            <textField><reportElement x="507" y="42" width="130" height="15"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$P{tgllahir}]]></textFieldExpression></textField>
            <textField><reportElement x="645" y="42" width="145" height="15"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$P{jk}.equals("L") ? "Laki-laki" : ($P{jk}.equals("P") ? "Perempuan" : "")]]></textFieldExpression></textField>
            <rectangle><reportElement x="0" y="70" width="802" height="22"/><graphicElement><pen lineWidth="0.8"/></graphicElement></rectangle>
            <staticText><reportElement x="0" y="73" width="802" height="17"/><textElement textAlignment="Center"><font size="13" isBold="true"/></textElement><text><![CDATA[PROFIL RINGKAS MEDIS RAWAT JALAN]]></text></staticText>
            <rectangle><reportElement x="0" y="92" width="802" height="22" backcolor="#EEEEEE" mode="Opaque"/><graphicElement><pen lineWidth="0.8"/></graphicElement></rectangle>
            <line><reportElement x="28" y="92" width="0" height="22"/></line><line><reportElement x="98" y="92" width="0" height="22"/></line><line><reportElement x="198" y="92" width="0" height="22"/></line><line><reportElement x="318" y="92" width="0" height="22"/></line><line><reportElement x="430" y="92" width="0" height="22"/></line><line><reportElement x="548" y="92" width="0" height="22"/></line><line><reportElement x="688" y="92" width="0" height="22"/></line>
            <staticText><reportElement x="0" y="95" width="28" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[No]]></text></staticText>
            <staticText><reportElement x="28" y="95" width="70" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Tgl / Jam]]></text></staticText>
            <staticText><reportElement x="98" y="95" width="100" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Diagnosa (ICD X)]]></text></staticText>
            <staticText><reportElement x="198" y="95" width="120" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Uraian Klinis Penting]]></text></staticText>
            <staticText><reportElement x="318" y="95" width="112" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Penunjang]]></text></staticText>
            <staticText><reportElement x="430" y="95" width="118" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Riwayat Rawat Inap/Operasi]]></text></staticText>
            <staticText><reportElement x="548" y="95" width="140" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Obat/Rencana Tindak Lanjut]]></text></staticText>
            <staticText><reportElement x="688" y="95" width="114" height="16"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[DPJP/Petugas]]></text></staticText>
        </band>
    </title>
    <detail>
        <band height="35" splitType="Stretch">
            <rectangle><reportElement x="0" y="0" width="802" height="35" stretchType="RelativeToTallestObject"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle>
            <line><reportElement x="28" y="0" width="0" height="35" stretchType="RelativeToTallestObject"/></line><line><reportElement x="98" y="0" width="0" height="35" stretchType="RelativeToTallestObject"/></line><line><reportElement x="198" y="0" width="0" height="35" stretchType="RelativeToTallestObject"/></line><line><reportElement x="318" y="0" width="0" height="35" stretchType="RelativeToTallestObject"/></line><line><reportElement x="430" y="0" width="0" height="35" stretchType="RelativeToTallestObject"/></line><line><reportElement x="548" y="0" width="0" height="35" stretchType="RelativeToTallestObject"/></line><line><reportElement x="688" y="0" width="0" height="35" stretchType="RelativeToTallestObject"/></line>
            <textField isStretchWithOverflow="true"><reportElement x="2" y="2" width="24" height="30"/><textElement textAlignment="Center"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{no}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="30" y="2" width="66" height="30"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{tanggal}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="100" y="2" width="96" height="30"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{diagnosa}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="200" y="2" width="116" height="30"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{klinis}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="320" y="2" width="108" height="30"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{penunjang}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="432" y="2" width="114" height="30"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{riwayat_inap}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="550" y="2" width="136" height="30"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{obat_rtl}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="690" y="2" width="110" height="30"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{petugas}]]></textFieldExpression></textField>
        </band>
    </detail>
