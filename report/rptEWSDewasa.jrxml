<rectangle><reportElement x="0" y="164" width="802" height="34" uuid="00000093-0000-4000-8000-000000000093"/><graphicElement><pen lineWidth="0.4" lineColor="#CCCCCC"/></graphicElement></rectangle>
<staticText><reportElement x="2" y="166" width="164" height="30" mode="Opaque" backcolor="#FFCC80" uuid="00000094-0000-4000-8000-000000000094"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="8" isBold="true" pdfFontName="Times-Bold" pdfEncoding="Cp1252"/></textElement><text><![CDATA[SKOR 5-6 atau 1 parameter SKOR 3]]></text></staticText>
<staticText><reportElement x="174" y="166" width="624" height="30" uuid="00000095-0000-4000-8000-000000000095"/><textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="8" pdfFontName="Times-Roman" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Assesment segera oleh dokter jaga (respon segera, maks 5 menit), konsultasi DPJP dan spesialis terkait, eskalasi perawatan dan monitoring tiap jam, pertimbangkan perawatan HCU]]></text></staticText>
<rectangle><reportElement x="0" y="200" width="802" height="34" uuid="00000096-0000-4000-8000-000000000096"/><graphicElement><pen lineWidth="0.4" lineColor="#CCCCCC"/></graphicElement></rectangle>
<staticText><reportElement x="2" y="202" width="164" height="30" mode="Opaque" backcolor="#EF9A9A" uuid="00000097-0000-4000-8000-000000000097"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="8" isBold="true" pdfFontName="Times-Bold" pdfEncoding="Cp1252"/></textElement><text><![CDATA[SKOR >= 7]]></text></staticText>
<staticText><reportElement x="174" y="202" width="624" height="30" uuid="00000098-0000-4000-8000-000000000098"/><textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="8" pdfFontName="Times-Roman" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Resusitasi dan monitoring secara kontinyu oleh dokter jaga dan perawat senior, panggil tim medis reaksi cepat, konsultasikan DPJP]]></text></staticText>
<rectangle><reportElement x="0" y="236" width="802" height="34" uuid="00000099-0000-4000-8000-000000000099"/><graphicElement><pen lineWidth="0.4" lineColor="#CCCCCC"/></graphicElement></rectangle>
<staticText><reportElement x="2" y="238" width="164" height="30" mode="Opaque" backcolor="#6495ED" forecolor="#FFFFFF" uuid="0000009a-0000-4000-8000-00000000009a"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="8" isBold="true" pdfFontName="Times-Bold" pdfEncoding="Cp1252"/></textElement><text><![CDATA[HENTI NAPAS/JANTUNG]]></text></staticText>
<staticText><reportElement x="174" y="238" width="624" height="30" uuid="0000009b-0000-4000-8000-00000000009b"/><textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="8" pdfFontName="Times-Roman" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Lakukan RJP, aktivasi henti jantung (118), respon tim henti jantung segera, maksimal 5 menit, resusitasi lanjutan oleh tim medis reaksi cepat (respon segera, maksimal 10 menit)]]></text></staticText>
<rectangle><reportElement x="0" y="276" width="802" height="1" mode="Opaque" backcolor="#69BE28" uuid="0000009c-0000-4000-8000-00000000009c"/><graphicElement><pen lineWidth="1.0"/></graphicElement></rectangle>
</band></summary>
