	<detail>
		<band height="136" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="54" height="136" stretchType="RelativeToTallestObject"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{tgl_perawatan}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="54" y="0" width="42" height="136" stretchType="RelativeToTallestObject"/>
				<box><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{jam_rawat}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="96" y="0" width="118" height="136" stretchType="RelativeToTallestObject"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{nama} + "\n" + $F{jbtn} + "\nNIP: " + $F{nip}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="214" y="0" width="86" height="136" stretchType="RelativeToTallestObject"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA["Suhu: " + $F{suhu_tubuh} + "\nTD: " + $F{tensi} + "\nNadi: " + $F{nadi} + "\nRR: " + $F{respirasi} + "\nSpO2: " + $F{spo2} + "\nGCS: " + $F{gcs} + "\nKesadaran: " + $F{kesadaran} + "\nBB/TB: " + $F{berat} + "/" + $F{tinggi}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="300" y="0" width="260" height="136" stretchType="RelativeToTallestObject"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA["S: " + $F{keluhan} + "\nO: " + $F{pemeriksaan} + "\nA: " + $F{penilaian} + "\nP: " + $F{rtl} + "\nInstruksi: " + $F{instruksi} + "\nEvaluasi: " + $F{evaluasi}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="560" y="0" width="110" height="136" stretchType="RelativeToTallestObject"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{alergi}]]></textFieldExpression>
			</textField>
			<frame>
				<reportElement x="670" y="0" width="120" height="136" stretchType="RelativeToTallestObject"/>
				<box><pen lineWidth="0.5"/></box>
				<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
					<reportElement x="8" y="4" width="104" height="52">
						<printWhenExpression><![CDATA[$F{validasi}.equals("Sudah") && $F{validator_photo} != null && !$F{validator_photo}.equals("")]]></printWhenExpression>
					</reportElement>
					<imageExpression class="java.awt.Image"><![CDATA[rekammedis.CetakCPPT.ambilGambarServer($P{url_penggajian} + $F{validator_photo})]]></imageExpression>
				</image>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement x="4" y="58" width="112" height="52"/>
					<textElement textAlignment="Center" verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement>
					<textFieldExpression><![CDATA[$F{validasi}.equals("Sudah") ? ("Diverifikasi oleh\n" + $F{nama_validator} + "\n" + $F{tgl_validasi} + " " + $F{jam_validasi}) : "Belum diverifikasi"]]></textFieldExpression>
				</textField>
			</frame>
		</band>
