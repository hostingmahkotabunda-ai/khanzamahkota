				<rectangle radius="4"><reportElement x="185" y="3" width="16" height="16" backcolor="#ECFDF5" mode="Opaque"/><graphicElement><pen lineWidth="0.5" lineColor="#BBF7D0"/></graphicElement></rectangle>
