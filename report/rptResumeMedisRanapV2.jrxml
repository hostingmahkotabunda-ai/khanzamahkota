				<textField><reportElement x="10" y="24" width="154" height="12"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[(($F{cara_keluar}.equals("Diijinkan Pulang")) ? "■ " : "□ ") + "di ijinkan pulang"]]></textFieldExpression></textField>
				<textField><reportElement x="10" y="38" width="154" height="12"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[(($F{cara_keluar}.equals("Melarikan Diri")) ? "■ " : "□ ") + "melarikan diri"]]></textFieldExpression></textField>
				<textField><reportElement x="10" y="52" width="160" height="12"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[(($F{cara_keluar}.equals("Pindah Rumah Sakit")) ? "■ " : "□ ") + "pindah rumah sakit"]]></textFieldExpression></textField>
				<textField><reportElement x="10" y="66" width="164" height="12"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[(($F{cara_keluar}.equals("Pulang Atas Permintaan Sendiri")) ? "■ " : "□ ") + "pulang atas permintaan sendiri"]]></textFieldExpression></textField>
