<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptAsesmenKeperawatan" language="groovy" pageWidth="595" pageHeight="842" columnWidth="543" leftMargin="26" rightMargin="26" topMargin="16" bottomMargin="16" uuid="b1a2c3d4-1111-2222-3333-444455556666">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="judul" class="java.lang.String"/>
	<parameter name="koderm" class="java.lang.String"/>
	<parameter name="isi" class="java.lang.String"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="ttd_label" class="java.lang.String"/>
	<parameter name="ttd_nama" class="java.lang.String"/>
	<parameter name="kota_ttd" class="java.lang.String"/>
	<parameter name="tgl_ttd" class="java.lang.String"/>
	<queryString>
		<![CDATA[select current_date()]]>
	</queryString>
	<background>
		<band splitType="Stretch"/>
	</background>
	<pageHeader>
		<band height="96" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank">
				<reportElement x="0" y="0" width="85" height="68"/>
				<imageExpression class="java.io.InputStream"><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<rectangle>
				<reportElement x="478" y="0" width="65" height="16"/>
			</rectangle>
			<textField isBlankWhenNull="true">
				<reportElement x="480" y="2" width="61" height="12"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{koderm}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="90" y="0" width="453" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="14" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{namars}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="90" y="20" width="453" height="11"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{alamatrs}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="90" y="31" width="453" height="11"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{kotars} + ( ($P{propinsirs}==null || $P{propinsirs}.equals("")) ? "" : " - " + $P{propinsirs} )]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="90" y="42" width="453" height="11"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA["Telp. " + ($P{kontakrs}==null?"":$P{kontakrs}) + ( ($P{emailrs}==null || $P{emailrs}.equals("")) ? "" : "   Email : " + $P{emailrs} )]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="58" width="543" height="1"/>
			</line>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="64" width="543" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="13" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{judul}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="88" width="543" height="1"/>
			</line>
		</band>
	</pageHeader>
	<detail>
		<band height="20" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="2" width="543" height="16" stretchType="RelativeToTallestObject"/>
				<textElement markup="html" verticalAlignment="Top"><font fontName="Tahoma" size="9"/></textElement>
				<textFieldExpression><![CDATA[$P{isi}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="116" splitType="Stretch">
			<line>
				<reportElement x="0" y="6" width="543" height="1"/>
			</line>
			<textField isBlankWhenNull="true">
				<reportElement x="350" y="12" width="193" height="12"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{kota_ttd} + ", " + $P{tgl_ttd}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="350" y="24" width="193" height="12"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{ttd_label}]]></textFieldExpression>
			</textField>
			<componentElement>
				<reportElement x="416" y="38" width="60" height="60" isRemoveLineWhenBlank="true"/>
				<jr:QRCode xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" errorCorrectionLevel="M">
					<jr:codeExpression><![CDATA[$P{finger}]]></jr:codeExpression>
				</jr:QRCode>
			</componentElement>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="350" y="100" width="193" height="14"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA["( " + ($P{ttd_nama}==null?"":$P{ttd_nama}) + " )"]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
